#!/usr/bin/env python3
"""rpcd exec bridge for the localhost-only iptv-speedtest HTTP API."""
import http.client
import ipaddress
import json
import socket
import subprocess
import sys

UCI_CONFIG = "iptv_speedtest"
PASSWORD_FILE = "/etc/iptv-speedtest/admin-password"
MAX_BODY = 1024 * 1024
MAX_REPORT_RESPONSE = 16 * 1024 * 1024
SHORT_TIMEOUT = 5
LONG_TIMEOUT = 25
# rpcd list parameter declarations use example values to infer types.
METHODS = {
    "status": {},
    "config": {},
    "report": {"offset": 0, "limit": 0, "query": ""},
    "failed": {"offset": 0, "limit": 0, "query": "", "reason": ""},
    "testsource": {"url": ""},
    "save": {"data": ""},
    "refresh": {},
    "stop": {},
}
GET_PATHS = {"status": "/api/status", "config": "/api/config",
             "report": "/api/report", "failed": "/api/failed"}
POST_PATHS = {"save": "/api/config", "testsource": "/api/testsource",
              "refresh": "/api/refresh", "stop": "/api/stop"}


def _result(ok, value=None, error=None):
    return {"ok": True, "data": value} if ok else {"ok": False, "error": error or "request failed"}


def _safe_error(exc):
    return "backend unavailable" if isinstance(exc, (OSError, socket.error, http.client.HTTPException, RuntimeError)) else "invalid backend response"


def read_uci():
    try:
        out = subprocess.check_output(["uci", "-q", "get", UCI_CONFIG + ".main.listen_host"], stderr=subprocess.DEVNULL, text=True).strip()
    except (OSError, subprocess.CalledProcessError):
        out = "127.0.0.1"
    try:
        port_s = subprocess.check_output(["uci", "-q", "get", UCI_CONFIG + ".main.port"], stderr=subprocess.DEVNULL, text=True).strip()
        port = int(port_s)
    except (OSError, subprocess.CalledProcessError, ValueError):
        port = 8899
    return out or "127.0.0.1", port


def local_bind(host, port):
    try:
        ip = ipaddress.ip_address(host)
        if ip.version != 4:
            raise ValueError
        if ip.is_unspecified:
            host = "127.0.0.1"
        elif ip.is_loopback:
            host = str(ip)
        else:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            try:
                s.bind((str(ip), 0))
            finally:
                s.close()
            host = str(ip)
        if not 1 <= int(port) <= 65535:
            raise ValueError
        return host, int(port)
    except (ValueError, OSError, TypeError):
        raise ValueError("invalid local backend")


def read_token():
    try:
        with open(PASSWORD_FILE, encoding="utf-8") as f:
            token = f.read().strip()
        if not token:
            raise ValueError
        return token
    except (OSError, ValueError):
        raise RuntimeError("backend unavailable")


def request(method, payload=None):
    host, port = local_bind(*read_uci())
    token = read_token()
    body = None
    headers = {"X-Token": token, "Accept": "application/json", "Connection": "close"}
    if payload is not None:
        body = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
        if len(body) > MAX_BODY:
            raise ValueError("request too large")
        headers["Content-Type"] = "application/json"
    path = (GET_PATHS if payload is None else POST_PATHS)[method]
    cap = MAX_REPORT_RESPONSE if method in ("report", "failed") else MAX_BODY
    conn = http.client.HTTPConnection(host, port, timeout=LONG_TIMEOUT if method == "testsource" else SHORT_TIMEOUT)
    try:
        conn.request("GET" if payload is None else "POST", path, body=body, headers=headers)
        response = conn.getresponse()
        raw = response.read(cap + 1)
        if len(raw) > cap:
            raise ValueError("backend response too large")
        if response.status < 200 or response.status >= 300:
            raise RuntimeError("backend rejected request")
        try:
            return json.loads(raw.decode("utf-8")) if raw else {}
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise ValueError("invalid backend response")
    finally:
        conn.close()


def paged(kind, params):
    raw = request(kind)
    if isinstance(raw, dict) and raw.get("ok") is False:
        return raw
    items = raw if isinstance(raw, list) else raw.get("items", []) if isinstance(raw, dict) else []
    if not isinstance(items, list):
        raise ValueError("invalid backend response")
    query = params.get("query", "")
    if not isinstance(query, str):
        raise ValueError("query must be string")
    if query:
        q = query.casefold()
        items = [x for x in items if q in json.dumps(x, ensure_ascii=False, default=str).casefold()]
    reasons = {}
    if kind == "failed":
        for item in items:
            reason = str(item.get("reason", ""))
            category = reason if reason.startswith("HTTP") else reason.split(" ")[0]
            reasons[category] = reasons.get(category, 0) + 1
        selected = params.get("reason", "")
        if selected:
            items = [x for x in items if str(x.get("reason", "")).startswith(selected)]
    offset = params.get("offset", 0)
    limit = params.get("limit", 100)
    if isinstance(offset, bool) or not isinstance(offset, int) or offset < 0:
        raise ValueError("offset must be non-negative int")
    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
        raise ValueError("limit must be non-negative int")
    limit = min(limit, 100)
    answer = {"items": items[offset:offset + limit], "total": len(items), "offset": offset, "limit": limit}
    if kind == "failed":
        answer["reasons"] = reasons
    return answer


def validate_params(method, params):
    if not isinstance(params, dict):
        raise ValueError("params must be object")
    if method == "testsource" and (not isinstance(params.get("url"), str) or not params["url"].strip()):
        raise ValueError("url must be string")
    if method == "save":
        data = params.get("data")
        if not isinstance(data, str) or len(data.encode()) > MAX_BODY:
            raise ValueError("data must be string")
        parsed = json.loads(data)
        if not isinstance(parsed, dict):
            raise ValueError("data must be JSON object")
    for key in ("offset", "limit"):
        if key in params and (isinstance(params[key], bool) or not isinstance(params[key], int)):
            raise ValueError(key + " must be int")
    if "query" in params and not isinstance(params["query"], str):
        raise ValueError("query must be string")
    if "reason" in params and not isinstance(params["reason"], str):
        raise ValueError("reason must be string")


def call(method, params):
    if method not in METHODS:
        return _result(False, error="unknown method")
    try:
        validate_params(method, params)
        if method in ("report", "failed"):
            answer = paged(method, params)
            if isinstance(answer, dict) and answer.get("ok") is False:
                return answer
            return _result(True, answer)
        if method == "save":
            answer = request(method, json.loads(params["data"]))
        elif method == "testsource":
            answer = request(method, {"url": params["url"]})
        elif method in GET_PATHS:
            answer = request(method)
            if method == "status" and isinstance(answer, dict):
                host, port = local_bind(*read_uci())
                answer = dict(answer)
                answer.update({"listen_host": host, "port": port})
        else:
            answer = request(method, {})
        if isinstance(answer, dict) and answer.get("ok") is False:
            return answer
        return _result(True, answer.get("config", answer) if isinstance(answer, dict) else answer)
    except Exception as exc:
        return _result(False, error=str(exc) if isinstance(exc, ValueError) else _safe_error(exc))


def main(argv):
    if len(argv) < 2:
        return {"ok": False, "error": "invalid rpcd invocation"}
    if argv[1] == "list":
        return METHODS
    # rpcd exec invokes binary call METHOD; there is no object name argument.
    if argv[1] != "call" or len(argv) < 3:
        return {"ok": False, "error": "invalid rpcd invocation"}
    try:
        params = json.load(sys.stdin) if not sys.stdin.isatty() else {}
    except Exception:
        return _result(False, error="invalid parameters")
    return call(argv[2], params)


if __name__ == "__main__":
    print(json.dumps(main(sys.argv), ensure_ascii=False, separators=(",", ":")))
