{
  "luci-app-iptv-speedtest": {
    "description": "IPTV speedtest administration",
    "read": {
      "uci": ["iptv_speedtest"],
      "ubus": {"service": ["list"], "file": ["read"]},
      "file": {"/etc/iptv-speedtest/admin-password": ["read"]}
    },
    "write": {
      "uci": ["iptv_speedtest"],
      "ubus": {"file": ["exec"]},
      "file": {"/usr/libexec/iptv-speedtest-ctl": ["exec"]}
    }
  }
}
